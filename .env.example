# Copy this file to .env and fill in your own values. Never commit .env.

# Required: Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key-here

# LLM models (Google Gemini, called through the google-genai SDK)
LLM_PRIMARY_MODEL=gemini-3-flash-preview
LLM_FALLBACK_MODEL=gemini-3.5-flash
# Thinking level for the primary and fallback model: minimal | low | medium | high
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=16000

# Website fetching
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=5
# Cleaned website text is truncated to this many characters before it is sent to the LLM
CONTENT_MAX_CHARS=20000
